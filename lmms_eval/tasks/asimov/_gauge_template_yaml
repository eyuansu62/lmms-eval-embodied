# ASIMOV · 读表共享配置（被 asimov_gauge_readable / asimov_gauge_unreadable include）
#
# 官方原协议：无 tools、无 system，题干就是官方原文（「只给数值；读不出就说 unreadable」）。
# 可读题：读数落在真值区间 [lo, hi] 内算对；不可读题：答 unreadable 算对。

dataset_path: json
test_split: test
output_type: generate_until

doc_to_visual: !function utils.asimov_doc_to_visual
doc_to_text: !function utils.asimov_gauge_doc_to_text
doc_to_target: !function utils.asimov_gauge_doc_to_target
process_results: !function utils.asimov_gauge_process_results

metric_list:
  - metric: asimov_accuracy
    aggregation: !function utils.asimov_aggregate_accuracy
    higher_is_better: true
  - metric: asimov_parse_rate
    aggregation: !function utils.asimov_aggregate_parse_rate
    higher_is_better: true

generation_kwargs:
  max_new_tokens: 65536
  temperature: 0
  top_p: 1.0
  num_beams: 1
  do_sample: false

lmms_eval_specific_kwargs:
  default:
    pre_prompt: ""
    post_prompt: ""

metadata:
  version: 0.1
