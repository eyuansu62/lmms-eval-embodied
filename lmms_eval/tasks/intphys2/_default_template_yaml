# IntPhys 2 · #35 物体恒常性 / #38 运动连续性（被 intphys2_permanence / intphys2_continuity include）
#
# 数据：facebook/IntPhys2 Main 集（CC BY-NC 4.0，仅限评测用途）；本地 jsonl + 帧图由 build_intphys2_frames.py 生成。
# 协议照官方 IntPhys2_openai.py：1 帧/秒（每视频 11–15 张）、官方 prompt1、Yes/No 子串判分。
# ⚠️ 可能/不可能各半，全答 Yes = 50%；论文里前沿 MLLM 在 53–64，人类 >90。读分对照 intphys2_yes_rate。

dataset_path: json
test_split: test
output_type: generate_until

doc_to_visual: !function utils.intphys2_doc_to_visual
doc_to_text: !function utils.intphys2_doc_to_text
doc_to_target: !function utils.intphys2_doc_to_target
process_results: !function utils.intphys2_process_results

metric_list:
  - metric: intphys2_accuracy
    aggregation: !function utils.intphys2_aggregate_accuracy
    higher_is_better: true
  - metric: intphys2_accuracy_strict
    aggregation: !function utils.intphys2_aggregate_accuracy_strict
    higher_is_better: true
  - metric: intphys2_yes_rate
    aggregation: !function utils.intphys2_aggregate_yes_rate
    higher_is_better: false
  - metric: intphys2_valid_rate
    aggregation: !function utils.intphys2_aggregate_valid_rate
    higher_is_better: true
  - metric: intphys2_pair_accuracy
    aggregation: !function utils.intphys2_aggregate_pair_accuracy
    higher_is_better: true

generation_kwargs:
  max_new_tokens: 65536
  temperature: 0
  top_p: 1.0
  num_beams: 1
  do_sample: false

metadata:
  version: 1.0
