# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored.

# Default OpenAI-compatible endpoint used by run_model.sh / run_a_tier_api.py
EVAL_ROUTER_BASE_URL=https://your-openai-compatible-endpoint/v1
EVAL_ROUTER_MODEL=qwen/qwen3-max
EVAL_ROUTER_API_KEY=your-key-here

# Extra endpoints, selected with PROFILE=<NAME> ./run_model.sh ...
# Each profile reads <NAME>_BASE_URL, <NAME>_API_KEY and optionally <NAME>_MODEL / <NAME>_PROXY.
# OPENROUTER is also the default judge profile for RoboBench planning questions (GPT-4o).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your-key-here
# OPENROUTER_PROXY=http://user:pass@host:port

# Optional: Hugging Face mirror, e.g. https://hf-mirror.com
# HF_ENDPOINT=
